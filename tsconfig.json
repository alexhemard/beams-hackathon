{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": false
  },
  "include": [
    "cli/**/*.ts",
    "plan-runner/**/*.ts",
    "investigator/**/*.ts",
    "shared/**/*.ts"
  ]
}