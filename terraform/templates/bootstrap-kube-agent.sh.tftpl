#!/usr/bin/env bash
# Generated by `terraform apply` (terraform/generated.tf) — do not edit by hand, it
# will be overwritten on the next apply. Installs ONLY teleport-kube-agent plus
# k8s/rbac.yaml on the ${cluster} EKS cluster: the one-time bootstrap that needs
# network access to the (private) EKS API endpoint, before Teleport has anything to
# proxy. Everything after this goes through Teleport (../demo/kubeup.sh).
#
# Run this from AWS CloudShell launched *in a VPC* (Actions > create VPC environment,
# or the CloudShell settings gear), picking:
#   VPC:             ${vpc_id}
#   Subnet:          one of ${subnet_ids}
#   Security group:  ${security_group_id}   (the EKS node group's own SG — already
#                                             allowed to reach the control plane)
# CloudShell then has a real network path to the private endpoint, same as the nodes
# do, with no bastion EC2 instance and no public exposure. See terraform/README.md.
#
# Contains a short-lived join token in plaintext below — this file is gitignored;
# don't commit or share it. Re-run `terraform apply` to regenerate it if it rotates.
set -euo pipefail

CLUSTER="${cluster}"
REGION="${region}"

echo "== kubectl / helm =="
command -v kubectl >/dev/null || { echo "kubectl not found (CloudShell has it preinstalled)"; exit 1; }
if ! command -v helm >/dev/null; then
  curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 -o /tmp/get-helm.sh
  chmod +x /tmp/get-helm.sh && /tmp/get-helm.sh
fi

echo "== kubeconfig (private endpoint, no public exposure) =="
aws eks update-kubeconfig --name "$CLUSTER" --region "$REGION" --alias bootstrap

echo "== namespace + RBAC =="
kubectl --context bootstrap create namespace "${namespace}" --dry-run=client -o yaml | kubectl --context bootstrap apply -f -
cat > /tmp/rbac.yaml <<'RBAC_EOF'
${rbac_yaml}
RBAC_EOF
kubectl --context bootstrap apply -f /tmp/rbac.yaml

echo "== teleport-kube-agent =="
helm repo add teleport https://charts.releases.teleport.dev >/dev/null 2>&1 || true
helm repo update >/dev/null
helm --kube-context bootstrap upgrade --install teleport-kube-agent teleport/teleport-kube-agent \
  --namespace teleport-agent --create-namespace \
  --set roles=kube \
  --set proxyAddr="${proxy}" \
  --set kubeClusterName="$CLUSTER" \
  --set authToken="${token}" \
  ${label_flags} \
  --wait --timeout 5m

echo
echo "done — '$CLUSTER' should now show up in \`tsh kube ls\`."
echo "Next: ../demo/kubeup.sh (through Teleport) to install the rest of the demo stack."
